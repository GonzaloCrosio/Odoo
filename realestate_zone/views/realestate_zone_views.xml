<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST -->
    <record id="view_realestate_zone_location_list" model="ir.ui.view">
        <field name="name">realestate.zone.location.list</field>
        <field name="model">realestate.zone.location</field>
        <field name="arch" type="xml">
            <list string="Zone Knowledge">
                <field name="name" width="120px" optional="show"/>
                <field name="property_type_id" width="120px" optional="show"/>
                <field name="occupant_info" width="120px" optional="show"/>
                <field name="neighborhood" width="120px" optional="show"/>
                <field name="state_id" width="120px" optional="show"/>
                <field name="street" width="120px" optional="show"/>
                <field name="unit_count" width="120px" optional="show"/>
                <field name="sale_potential" widget="badge" width="120px" optional="show"
                       decoration-success="sale_potential == 'high'"
                       decoration-warning="sale_potential == 'medium'"
                       decoration-muted="sale_potential == 'low'"/>
                <field name="next_contact_date" width="120px" optional="show"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_realestate_zone_location_form" model="ir.ui.view">
        <field name="name">realestate.zone.location.form</field>
        <field name="model">realestate.zone.location</field>
        <field name="arch" type="xml">
            <form string="Zone Knowledge">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="property_type_id"/>
                            <field name="occupant_info"/>
                            <field name="partner_id"/>
                            <field name="sale_potential"/>
                        </group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="neighborhood"/>
                            <field name="zip"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Characteristics">
                            <group>
                                <group>
                                    <field name="rooms"/>
                                    <field name="bedrooms"/>
                                    <field name="bathrooms"/>
                                </group>
                                <group>
                                    <field name="total_area"/>
                                    <field name="covered_area"/>
                                </group>
                            </group>
                        </page>
                        <page string="Units / Departments">
                            <field name="unit_ids">
                                <list string="Units" editable="bottom">
                                    <field name="sequence" widget="handle" width="50px" optional="hide"/>
                                    <field name="name" width="180px" optional="show"/>
                                    <field name="floor" width="80px" optional="show"/>
                                    <field name="property_type_id" width="120px" optional="show"/>
                                    <field name="occupant_info" width="180px" optional="show"/>
                                    <field name="rooms" width="80px" optional="show"/>
                                    <field name="bathrooms" width="80px" optional="show"/>
                                    <field name="area" width="120px" optional="show"/>
                                    <field name="sale_potential" width="120px" optional="show"/>
                                    <field name="observation" width="120px" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contact &amp; Rapport">
                            <group>
                                <group string="Contact">
                                    <field name="contact_name"/>
                                    <field name="contact_phone" widget="phone"/>
                                    <field name="contact_email" widget="email"/>
                                    <field name="best_contact_time"/>
                                </group>
                                <group string="Follow-up">
                                    <field name="last_contact_date"/>
                                    <field name="next_contact_date"/>
                                </group>
                            </group>
                            <group string="Rapport / Personal Notes">
                                <field name="rapport_notes" placeholder="Notes" colspan="2" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Observations">
                            <group>
                                <field name="observation_1"/>
                                <field name="observation_2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_realestate_zone_location_search" model="ir.ui.view">
        <field name="name">realestate.zone.location.search</field>
        <field name="model">realestate.zone.location</field>
        <field name="arch" type="xml">
            <search string="Zone Knowledge">
                <field name="name"/>
                <field name="occupant_info"/>
                <field name="contact_name"/>
                <field name="neighborhood"/>
                <field name="state_id"/>
                <field name="street"/>
                <field name="property_type_id"/>
                <filter name="filter_high" string="High Potential"
                        domain="[('sale_potential', '=', 'high')]"/>
                <filter name="filter_medium" string="Medium Potential"
                        domain="[('sale_potential', '=', 'medium')]"/>
                <separator/>
                <filter name="filter_to_follow" string="Follow-up Scheduled"
                        domain="[('next_contact_date', '!=', False)]"/>
                <group>
                    <filter name="group_potential" string="Sale Potential"
                            context="{'group_by': 'sale_potential'}"/>
                    <filter name="group_type" string="Property Type"
                            context="{'group_by': 'property_type_id'}"/>
                    <filter name="group_province" string="Province"
                            context="{'group_by': 'state_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_realestate_zone_location" model="ir.actions.act_window">
        <field name="name">Zone Knowledge</field>
        <field name="res_model">realestate.zone.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_realestate_zone_location_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first zone-knowledge property
            </p>
        </field>
    </record>
</odoo>
