<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_realestate_province_list" model="ir.ui.view">
        <field name="name">realestate.province.list</field>
        <field name="model">realestate.province</field>
        <field name="arch" type="xml">
            <list string="Provinces" editable="bottom">
                <field name="name" optional="show"/>
                <field name="code" optional="show"/>
                <field name="country_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_realestate_province_form" model="ir.ui.view">
        <field name="name">realestate.province.form</field>
        <field name="model">realestate.province</field>
        <field name="arch" type="xml">
            <form string="Province">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="country_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_realestate_province_search" model="ir.ui.view">
        <field name="name">realestate.province.search</field>
        <field name="model">realestate.province</field>
        <field name="arch" type="xml">
            <search string="Provinces">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
            </search>
        </field>
    </record>

    <record id="action_realestate_province" model="ir.actions.act_window">
        <field name="name">Provinces</field>
        <field name="res_model">realestate.province</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_realestate_province_search"/>
    </record>
</odoo>
