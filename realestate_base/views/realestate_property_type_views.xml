<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_realestate_property_type_list" model="ir.ui.view">
        <field name="name">realestate.property.type.list</field>
        <field name="model">realestate.property.type</field>
        <field name="arch" type="xml">
            <list string="Property Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" optional="show"/>
                <field name="code" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_realestate_property_type_form" model="ir.ui.view">
        <field name="name">realestate.property.type.form</field>
        <field name="model">realestate.property.type</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_realestate_property_type_search" model="ir.ui.view">
        <field name="name">realestate.property.type.search</field>
        <field name="model">realestate.property.type</field>
        <field name="arch" type="xml">
            <search string="Property Types">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_realestate_property_type" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">realestate.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_realestate_property_type_search"/>
    </record>
</odoo>
