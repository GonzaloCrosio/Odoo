<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Acciones Planificadas cada 12 horas-->
        <record id="ir_cron_update_crypto_prices" model="ir.cron">
            <field name="name">Update Cryptocurrency Prices (Hourly)</field>
            <field name="model_id" ref="model_investment_crypto_price"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_prices()</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
